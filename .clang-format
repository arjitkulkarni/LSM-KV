---
BasedOnStyle: Google
ColumnLimit: 90
ReflowComments: false   # keep hand-drawn format diagrams in comments intact
DerivePointerAlignment: false
PointerAlignment: Left
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<[a-z_]+\.h>$'        # C system headers
    Priority: 1
  - Regex: '^<[a-z_/]+>$'          # C++ standard library
    Priority: 2
  - Regex: '^<'                    # other system/third-party
    Priority: 3
  - Regex: '.*'                    # project headers
    Priority: 4
